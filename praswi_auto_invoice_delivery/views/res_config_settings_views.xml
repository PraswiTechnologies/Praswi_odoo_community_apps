<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_inv_delivery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.auto.inv.delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="inside">
                <setting id="praswi_auto_inv_so_delivery_setting"
                         string="Auto-Invoice on Delivery Validation (SO)"
                         help="Automatically generate Customer Invoices from Sales Orders when outgoing Deliveries are validated.">
                    <field name="auto_create_invoice_on_delivery"/>
                    <div class="content-group mt-2" invisible="not auto_create_invoice_on_delivery">
                        <div class="row">
                            <label for="auto_post_so_delivery_invoice" class="col-lg-4 o_light_label"/>
                            <field name="auto_post_so_delivery_invoice"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
